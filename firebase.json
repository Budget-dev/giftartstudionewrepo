{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "public": ".firebase/studio-157276530-549e7/hosting",
    "cleanUrls": true,
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/product/**",
        "destination": "/product/index.html"
      },
      {
        "source": "/category/**",
        "destination": "/category/index.html"
      },
      {
        "source": "/shop/**",
        "destination": "/shop/index.html"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
