rules_version = '2';

// ===============================================================
// Assumed Data Model & Architecture
// ===============================================================
//
// Collection: products
// Document ID: productId (auto-generated or slug)
// Fields:
//   - name: string (required) - Product title
//   - price: number (required) - Price in INR
//   - image: string (optional) - Main product image URL
//   - category: string (optional) - Category identifier
//   - subcategory: string (optional) - Subcategory identifier
//
// Collection: banners
// Document ID: bannerId (auto-generated)
// Fields:
//   - title: string (optional) - Banner title/heading
//   - subtitle: string (optional) - Banner description
//   - imageUrl: string (required) - Banner media URL
//   - link: string (optional) - Target redirect link
//   - active: bool (optional) - Visibility toggle
//   - order: number (optional) - Display priority
//   - createdAt: timestamp (optional)
//
// Collection: artists
// Document ID: artistId (auto-generated or Auth UID)
// Fields:
//   - name: string (required) - Artist full name / studio name
//   - email: string (required) - Artist contact email
//   - bio: string (optional) - Bio / artistic background
//   - portfolio: string (optional) - Portfolio URL / external links
//   - avatar: string (optional) - Profile picture URL
//   - status: string (optional) - Application status ('pending', 'approved', 'rejected')
//   - userId: string (optional) - Auth UID if linked to user account
//   - createdAt: timestamp (optional)
//
// Collection: artworks
// Document ID: artworkId (auto-generated)
// Fields:
//   - title: string (required) - Artwork title
//   - description: string (optional) - Medium, description, story
//   - image: string (optional) - Artwork image URL
//   - artistId: string (optional) - Artist ID / Auth UID
//   - userId: string (optional) - Submitting artist Auth UID
//   - status: string (required) - 'pending_review', 'approved', 'rejected', 'published'
//   - finalPrice: number (optional) - Approved selling price set by super owner
//   - isPublished: bool (optional) - Visibility in public gallery
//   - createdAt: timestamp (optional)
//
// Collection: orders
// Document ID: orderId (auto-generated)
// Fields:
//   - userId: string (required) - 'guest' or Auth UID
//   - customerName: string (required, 1-200 chars) - Buyer / recipient name
//   - email: string (optional) - Contact email
//   - phone: string (optional) - Contact phone number
//   - items: list (required, 1-100 items) - Ordered products list
//   - total: number (required, > 0) - Order total amount
//   - discountAmount: number (optional) - Applied discount amount
//   - couponCode: string (optional) - Applied coupon code
//   - status: string (optional) - Order status ('Paid', 'Pending', etc.)
//   - trackingStatus: string (optional) - Tracking step ('Order Placed', 'Shipped', etc.)
//   - shippingAddress: map (optional) - Delivery address
//   - paymentMethod: string (optional) - Payment provider
//   - paymentStatus: string (optional) - Payment status
//   - transactionId: string (optional) - Payment / UTR reference
//   - createdAt: timestamp (optional) - Creation timestamp
//
// Collection: payments
// Document ID: paymentId (auto-generated or razorpay payment id)
// Fields:
//   - orderId: string (required) - Associated order document ID
//   - razorpayPaymentId: string (required) - Gateway transaction reference
//   - amount: number (required, > 0) - Amount paid in INR
//   - status: string (required) - Payment status (e.g. 'Captured', 'Paid')
//   - userId: string (optional) - 'guest' or Auth UID
//   - createdAt: timestamp (optional) - Verification/creation timestamp
//
// Collection: coupons
// Document ID: couponId (auto-generated)
// Fields:
//   - code: string (required) - Discount code
//   - discountType: string (required) - 'Percentage' or 'Fixed'
//   - value: number (required) - Discount value
//   - status: string (required) - 'Active' / 'Inactive'
//   - usageCount: number (required) - Usage counter (incremented during checkout)
//   - createdAt: timestamp (optional)
//
// Collection: users
// Document ID: userId (matches auth.uid)
// Fields:
//   - uid: string (required, immutable) - Auth UID
//   - displayName: string (optional) - Full name
//   - email: string (optional) - Primary email
//   - phoneNumber: string (optional) - Contact phone
//   - role: string (optional) - 'admin' (only for super owner) or 'user'
//   - createdAt: timestamp (optional)
//
// Collection: wishlist
// Document ID: docId (auto-generated)
// Fields:
//   - userId: string (required, immutable) - Auth UID
//   - productId: string (required) - Product identifier
//   - name: string (optional) - Product title
//   - price: number (optional) - Product price
//   - image: string (optional) - Product image
//   - addedAt: timestamp/date (optional)
//
// Collection: customized_orders
// Document ID: orderId (auto-generated)
// Fields:
//   - userId: string (required) - Auth UID
//   - productName: string (required) - Base product name
//   - customPrompt: string (required) - AI customization prompt
//   - generatedDesignImage: string (required) - AI design image URL
//   - price: number (required) - Price with customization fee
//   - status: string (required) - Order status
//   - createdAt: timestamp (optional)
//
// Collection: settings
// Document ID: docId (e.g. 'seo')
//
// Collection: homepageDesktop, homepage_sections, mobile_homepage_sections
// Document ID: docId
//
// Collection: rto
// Document ID: rtoId
//
// Collection: purchase_popups
// Document ID: popupId (auto-generated)
// Fields:
//   - buyerName: string (optional) - Buyer display name
//   - productName: string (optional) - Purchased product name
//   - location: string (optional) - Buyer city/location
//   - timeLabel: string (optional) - Relative time label
//   - imageUrl: string (optional) - Product thumbnail URL
//   - productUrl: string (optional) - Target product link
//   - active: bool (optional) - Visibility toggle
//   - order: number (optional) - Display priority
//   - createdAt: timestamp (optional)
//
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================

    function isSignedIn() {
      return request.auth != null;
    }

    // STRICT: Only the specific owner email can perform admin actions
    function isSuperOwner() {
      return isSignedIn() && request.auth.token.email == 'rohanswakkargiftartstudio@gmail.com';
    }

    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    function areImmutableFieldsUnchanged(fields) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(fields);
    }

    // Domain Validator: Orders Creation
    function isValidOrderCreate() {
      return hasRequiredFields(['customerName', 'total', 'items']) &&
             request.resource.data.total is number && request.resource.data.total > 0 &&
             request.resource.data.items is list && request.resource.data.items.size() > 0 && request.resource.data.items.size() <= 100 &&
             request.resource.data.customerName is string && request.resource.data.customerName.size() > 0 && request.resource.data.customerName.size() <= 200 &&
             (!('userId' in request.resource.data) || request.resource.data.userId is string);
    }

    // Domain Validator: Payments Creation
    function isValidPaymentCreate() {
      return hasRequiredFields(['orderId', 'razorpayPaymentId', 'amount', 'status']) &&
             request.resource.data.orderId is string &&
             request.resource.data.orderId.size() > 0 &&
             request.resource.data.orderId.size() <= 128 &&
             request.resource.data.razorpayPaymentId is string &&
             request.resource.data.razorpayPaymentId.size() > 0 &&
             request.resource.data.razorpayPaymentId.size() <= 128 &&
             request.resource.data.amount is number &&
             request.resource.data.amount > 0 &&
             request.resource.data.status is string &&
             request.resource.data.status.size() > 0 &&
             request.resource.data.status.size() <= 50 &&
             (!('userId' in request.resource.data) || request.resource.data.userId is string);
    }

    // Domain Validator: Coupon Usage Increment
    function isCouponUsageIncrement() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usageCount']) &&
             request.resource.data.usageCount is number &&
             (
               !('usageCount' in resource.data) ||
               request.resource.data.usageCount == resource.data.usageCount + 1
             );
    }

    // Domain Validator: User Profile Creation
    function isValidUserCreate(userId) {
      return (!('uid' in request.resource.data) || request.resource.data.uid == userId) &&
             (!('role' in request.resource.data) || request.resource.data.role != 'admin' || isSuperOwner());
    }

    // Domain Validator: User Profile Update
    function isValidUserUpdate() {
      return areImmutableFieldsUnchanged(['uid']) &&
             (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']) || isSuperOwner());
    }

    // Domain Validator: Artist Registration Application
    function isValidArtistCreate() {
      return hasRequiredFields(['name', 'email']) &&
             request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 100 &&
             request.resource.data.email is string && request.resource.data.email.size() > 0 && request.resource.data.email.size() <= 150 &&
             (!('status' in request.resource.data) || request.resource.data.status in ['pending', 'pending_review', 'submitted'] || isSuperOwner()) &&
             (!('userId' in request.resource.data) || request.resource.data.userId is string);
    }

    // Check if current user is the owner of the artist profile
    function isArtistDocOwner(artistId) {
      return isSignedIn() && (
        request.auth.uid == artistId ||
        (('userId' in resource.data) && resource.data.userId == request.auth.uid)
      );
    }

    // Domain Validator: Artwork Submission
    function isValidArtworkCreate() {
      return isSignedIn() &&
             hasRequiredFields(['title', 'status']) &&
             request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 200 &&
             request.resource.data.status is string &&
             (request.resource.data.status == 'pending_review' || isSuperOwner()) &&
             (!('artistId' in request.resource.data) || request.resource.data.artistId == request.auth.uid || isSuperOwner()) &&
             (!('userId' in request.resource.data) || request.resource.data.userId == request.auth.uid || isSuperOwner());
    }

    // ===============================================================
    // Collection Match Rules
    // ===============================================================

    // Products: Public read for browsing, super owner full management
    match /products/{productId} {
      allow read: if true;
      allow write: if isSuperOwner();
    }

    // Hero & Promo Banners: Public read, super owner write
    match /banners/{bannerId} {
      allow read: if true;
      allow write: if isSuperOwner();
    }

    // Purchase Popups: Public read, super owner write
    match /purchase_popups/{popupId} {
      allow read: if true;
      allow write: if isSuperOwner();
    }

    // Artists: Public read for displaying profiles and bios on artworks.
    // Public create allowed for artist registration applications with validation.
    // Artist owner can update profile information; super owner can approve, reject, or edit.
    match /artists/{artistId} {
      allow read: if true;
      allow create: if isSuperOwner() || isValidArtistCreate();
      allow update: if isSuperOwner() || 
                       (isArtistDocOwner(artistId) && 
                        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'approved', 'verified']));
      allow delete: if isSuperOwner();
    }

    // Artworks: Public read for gallery visitors.
    // Authenticated/registered artists can create submissions with status 'pending_review'.
    // Super owner can read, write, approve, set final selling price, and publish.
    match /artworks/{artworkId} {
      allow read: if true;
      allow create: if isSuperOwner() || isValidArtworkCreate();
      allow update: if isSuperOwner() ||
                       (isSignedIn() && 
                        (('artistId' in resource.data && resource.data.artistId == request.auth.uid) || 
                         ('userId' in resource.data && resource.data.userId == request.auth.uid)) &&
                        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'approved', 'finalPrice', 'sellingPrice', 'isPublished']));
      allow delete: if isSuperOwner();
    }

    // Orders: Public create for guest & user checkout with strict validation.
    // Read allowed for super owner, authenticated order owner, or single document read matching order ID (guest tracking).
    // Update and delete strictly restricted to super owner.
    match /orders/{orderId} {
      allow get: if isSuperOwner() || 
                    (isSignedIn() && resource.data.userId == request.auth.uid) || 
                    orderId == resource.id;
      allow list: if isSuperOwner() || 
                     (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSuperOwner() || isValidOrderCreate();
      allow update, delete: if isSuperOwner();
    }

    // Payments: Audit log for verified gateway transactions.
    // Public creation allowed with validated payload (or super owner).
    // Read restricted to super owner or authenticated transaction owner.
    // Update/delete strictly reserved for super owner.
    match /payments/{paymentId} {
      allow read: if isSuperOwner() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSuperOwner() || isValidPaymentCreate();
      allow update, delete: if isSuperOwner();
    }

    // Coupons: Public read for checkout validation, super owner create/delete.
    // Customers (guest/auth) can update ONLY usageCount via increment(1) upon checkout.
    match /coupons/{couponId} {
      allow read: if true;
      allow create, delete: if isSuperOwner();
      allow update: if isSuperOwner() || isCouponUsageIncrement();
    }

    // Users: Owner or super owner access, with RBAC privilege protection
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isSuperOwner());
      allow create: if isSignedIn() && (request.auth.uid == userId || isSuperOwner()) && isValidUserCreate(userId);
      allow update: if isSignedIn() && (request.auth.uid == userId || isSuperOwner()) && isValidUserUpdate();
      allow delete: if isSuperOwner();
    }

    // Wishlist: Authenticated user or super owner only. Guest mode uses localStorage.
    match /wishlist/{docId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isSuperOwner());
      allow create: if isSignedIn() && (request.resource.data.userId == request.auth.uid || isSuperOwner());
      allow update, delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isSuperOwner());
    }

    // Customized AI Orders: Owner create/read, super owner full control
    match /customized_orders/{orderId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isSuperOwner());
      allow create: if isSignedIn() && (request.resource.data.userId == request.auth.uid || isSuperOwner());
      allow update, delete: if isSuperOwner();
    }

    // Homepage Configurations: Public read, super owner write
    match /homepageDesktop/{docId} {
      allow read: if true;
      allow write: if isSuperOwner();
    }

    match /mobile_homepage_sections/{docId} {
      allow read: if true;
      allow write: if isSuperOwner();
    }

    match /homepage_sections/{docId} {
      allow read: if true;
      allow write: if isSuperOwner();
    }

    // Settings: Public read (SEO, dynamic tags), super owner write
    match /settings/{docId} {
      allow read: if true;
      allow write: if isSuperOwner();
    }

    // Return to Origin (RTO) cases: Admin only
    match /rto/{rtoId} {
      allow read, write: if isSuperOwner();
    }

    // Catch-all: Super owner only for unlisted collections / admin tasks
    match /{path=**} {
      allow read, write: if isSuperOwner();
    }
  }
}
